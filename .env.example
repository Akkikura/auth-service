APP_ENV=development
# порт можно поменять если 8080 занят
HTTP_PORT=8080

HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=5s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=65536
# заголовки прокси читаю только от своих адресов
HTTP_TRUSTED_PROXY_CIDRS=

POSTGRES_URL=postgres://auth:auth@postgres:5432/auth?sslmode=disable
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=5m
POSTGRES_HEALTH_TIMEOUT=1s

REDIS_ADDRESS=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_POOL_SIZE=20
REDIS_HEALTH_TIMEOUT=1s
REDIS_KEY_PREFIX=auth:

# в проде ключ беру из секретов
AUTH_SESSION_HASH_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AUTH_SESSION_TTL=30m
AUTH_ARGON2_MEMORY_KB=19456
AUTH_ARGON2_TIME=2
AUTH_ARGON2_THREADS=1
AUTH_ARGON2_KEY_LENGTH=32
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_HASH_CONCURRENCY=4

RATE_LOGIN_IP_LIMIT=30
RATE_LOGIN_IDENTITY_LIMIT=10
RATE_LOGIN_WINDOW=15m
RATE_REGISTER_IP_LIMIT=10
RATE_REGISTER_WINDOW=1h
